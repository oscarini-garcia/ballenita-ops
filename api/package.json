{
  "name": "ballena-ops-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de Ballena Ops sobre Cloudflare Workers y D1 🐳",
  "scripts": {
    "dev": "wrangler dev",
    "desplegar": "wrangler deploy",
    "migrar:local": "wrangler d1 execute ballena-ops --local --file=migraciones/0001_esquema.sql",
    "migrar:remoto": "wrangler d1 execute ballena-ops --remote --file=migraciones/0001_esquema.sql",
    "migrar:local5": "wrangler d1 execute ballena-ops --local --file=migraciones/0005_demo_y_platos_por_evento.sql",
    "migrar:remoto5": "wrangler d1 execute ballena-ops --remote --file=migraciones/0005_demo_y_platos_por_evento.sql",
    "migrar:local6": "wrangler d1 execute ballena-ops --local --file=migraciones/0006_ideas_de_plan.sql",
    "migrar:remoto6": "wrangler d1 execute ballena-ops --remote --file=migraciones/0006_ideas_de_plan.sql",
    "migrar:local7": "wrangler d1 execute ballena-ops --local --file=migraciones/0007_idea_con_autor.sql",
    "migrar:remoto7": "wrangler d1 execute ballena-ops --remote --file=migraciones/0007_idea_con_autor.sql",
    "migrar:local8": "wrangler d1 execute ballena-ops --local --file=migraciones/0008_alias_de_familia_y_fechas.sql",
    "migrar:remoto8": "wrangler d1 execute ballena-ops --remote --file=migraciones/0008_alias_de_familia_y_fechas.sql",
    "sembrar:ejemplo": "node herramientas/sembrar-ejemplo.mjs",
    "borrar:ejemplo": "wrangler d1 execute ballena-ops --remote --file=herramientas/borrar-ejemplo.sql",
    "test": "node --test 'test/*.test.js'",
    "migrar:local9": "wrangler d1 execute ballena-ops --local --file=migraciones/0009_recetas_con_cantidades.sql",
    "migrar:remoto9": "wrangler d1 execute ballena-ops --remote --file=migraciones/0009_recetas_con_cantidades.sql",
    "migrar:local10": "wrangler d1 execute ballena-ops --local --file=migraciones/0010_mejoras.sql",
    "migrar:remoto10": "wrangler d1 execute ballena-ops --remote --file=migraciones/0010_mejoras.sql",
    "generar:migraciones": "node herramientas/generar-migraciones.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
